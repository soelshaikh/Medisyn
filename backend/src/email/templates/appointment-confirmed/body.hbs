{{> header frontendUrl=frontendUrl}}
<h1>Appointment confirmed</h1>
<p>Hi {{firstName}}, your appointment has been confirmed. Here are the details:</p>
<table style="width:100%;border-collapse:collapse;margin:0 0 20px;">
  <tr style="background:#F7F9FB;">
    <th style="text-align:left;padding:8px 10px;font-size:13px;color:#718096;border-bottom:1px solid #E2E8F0;">Service</th>
    <td style="padding:8px 10px;font-size:14px;">{{serviceName}}</td>
  </tr>
  <tr>
    <th style="text-align:left;padding:8px 10px;font-size:13px;color:#718096;border-bottom:1px solid #E2E8F0;">Date &amp; Time</th>
    <td style="padding:8px 10px;font-size:14px;">{{appointmentDate}}</td>
  </tr>
  <tr style="background:#F7F9FB;">
    <th style="text-align:left;padding:8px 10px;font-size:13px;color:#718096;">Location</th>
    <td style="padding:8px 10px;font-size:14px;">{{location}}</td>
  </tr>
</table>
<p>
  <a href="{{appointmentUrl}}" class="btn">View appointment</a>
</p>
<p class="small">Need to reschedule? Visit your <a href="{{appointmentUrl}}">appointments page</a> or contact the pharmacy directly.</p>
{{> footer currentYear=currentYear}}
