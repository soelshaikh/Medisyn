# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=your_mongodb_atlas_uri_here

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ── Email ─────────────────────────────────────────────────────
EMAIL_FROM=noreply@medisyn.ca
EMAIL_FROM_NAME=MediSyn

# Option 1: Brevo (recommended — HTTP API, port 443, works on all cloud platforms)
# Get API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Option 2: Resend SMTP fallback
RESEND_API_KEY=

# Option 3: SendGrid SMTP fallback
SENDGRID_API_KEY=

# Option 4: Custom SMTP (last resort / local dev)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# ── File Storage ─────────────────────────────────────────────
# Set to "local" for development (files saved to uploads/ folder)
# Set to "s3" for production (AWS S3, Cloudflare R2, MinIO, Backblaze B2)
FILE_STORAGE_PROVIDER=local

# S3-compatible storage credentials (required when FILE_STORAGE_PROVIDER=s3)
#
# Cloudflare R2 example:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=medisyn-storage
#   S3_ACCESS_KEY_ID=<r2-access-key-id>
#   S3_SECRET_ACCESS_KEY=<r2-secret>
#   S3_PUBLIC_URL=https://pub-<hash>.r2.dev          # public bucket URL (for product images)
#
# AWS S3 example:
#   S3_ENDPOINT=                                      # leave empty for AWS
#   S3_REGION=ca-central-1
#   S3_BUCKET=medisyn-storage
#   S3_ACCESS_KEY_ID=<iam-access-key>
#   S3_SECRET_ACCESS_KEY=<iam-secret>
#   S3_PUBLIC_URL=                                    # leave empty, URLs are constructed automatically
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Invoice ───────────────────────────────────────────────────
# IANA timezone for financial year calculation (Canadian Eastern)
APP_TIMEZONE=America/Toronto
# How many days a guest invoice download token remains valid
INVOICE_GUEST_TOKEN_TTL_DAYS=30

# ── Seed Admin ────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@medisyn.ca
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=MediSyn Admin
