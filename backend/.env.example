# ── PostgreSQL — regular app_user pool ───────────────────────
DATABASE_URL=postgresql://app_user_login:app_user_pass@localhost:5432/vtechmed

# ── PostgreSQL — super admin pool (BYPASSRLS) ─────────────────
DATABASE_SUPER_ADMIN_URL=postgresql://app_super_admin_login:super_admin_pass@localhost:5432/vtechmed

# ── PostgreSQL admin (for DDL scripts) ───────────────────────
DATABASE_ADMIN_URL=postgresql://vtechmed:vtechmed_secret@localhost:5432/vtechmed

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-me-to-32-random-bytes-minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── App ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
